  // Omarchy's on/off pairs ("Nightlight On" / "Nightlight Off", shown one at a
  // time) as one switch each: the first row of the pair becomes the switch and
  // keeps its place and icon, the second is hidden. Flipping a switch keeps
  // the menu open.
  "trigger.toggle.idle-lock-on": {"label":"Stay Awake","toggle":true,"when":"true","checked":"[[ -f ~/.local/state/omarchy/indicators/stay-awake ]]"},
  "trigger.toggle.idle-lock-off": {"when":"false"},
  "trigger.toggle.notifications-on": {"label":"Silence Notifications","toggle":true,"when":"true","checked":"[[ $(omarchy-shell notifications isDnd) == on ]]"},
  "trigger.toggle.notifications-off": {"when":"false"},
  "trigger.toggle.nightlight-on": {"label":"Nightlight","toggle":true,"when":"true","checked":"[[ $(omarchy-toggle-nightlight --status) == *'\"enabled\":true'* ]]"},
  "trigger.toggle.nightlight-off": {"when":"false"},
  "trigger.toggle.screensaver-on": {"label":"Screensaver","toggle":true,"when":"true","checked":"! omarchy-toggle-enabled screensaver-off"},
  "trigger.toggle.screensaver-off": {"when":"false"},
  "trigger.toggle.crash-capture-on": {"label":"Crash Capture","toggle":true,"when":"true","checked":"! omarchy-toggle-enabled crash-capture-off"},
  "trigger.toggle.crash-capture-off": {"when":"false"},
  "trigger.hardware.laptop-display-on": {"label":"Laptop Display","toggle":true,"when":"omarchy-hw-laptop","checked":"! omarchy-hyprland-toggle-enabled internal-monitor-disable"},
  "trigger.hardware.laptop-display-off": {"when":"false"},
  "trigger.hardware.mirror-display-on": {"label":"Display Mirroring","toggle":true,"when":"omarchy-hw-laptop","checked":"omarchy-hyprland-toggle-enabled internal-monitor-mirror"},
  "trigger.hardware.mirror-display-off": {"when":"false"},
  "trigger.hardware.touchpad-on": {"label":"Touchpad","toggle":true,"when":"omarchy-hw-touchpad","checked":"[[ ! -f ~/.local/state/omarchy/toggles/hypr/touchpad-disabled-name ]]"},
  "trigger.hardware.touchpad-off": {"when":"false"},
  "trigger.hardware.touchscreen-on": {"label":"Touchscreen","toggle":true,"when":"omarchy-hw-touchscreen","checked":"[[ ! -f ~/.local/state/omarchy/toggles/hypr/touchscreen-disabled-name ]]"},
  "trigger.hardware.touchscreen-off": {"when":"false"},
  "appearance.windows.gaps-on": {"label":"Window Gaps","toggle":true,"when":"true","checked":"! omarchy-hyprland-toggle-enabled window-no-gaps"},
  "appearance.windows.gaps-off": {"when":"false"},
  "appearance.windows.one-window-ratio-on": {"label":"1-Window Ratio","toggle":true,"when":"true","checked":"omarchy-hyprland-toggle-enabled single-window-aspect-ratio"},
  "appearance.windows.one-window-ratio-off": {"when":"false"},
  "appearance.animations-on": {"label":"Animations","toggle":true,"when":"true","checked":"! omarchy-hyprland-toggle-enabled no-animations"},
  "appearance.animations-off": {"when":"false"},
  "appearance.top-bar.hide": {"label":"Bar","toggle":true,"when":"true","checked":"! omarchy-toggle-enabled bar-off"},
  "appearance.top-bar.show": {"when":"false"},
  "appearance.top-bar.indicators.battery-percentage-on": {"label":"Battery %","toggle":true,"when":"omarchy-hw-laptop","checked":"[[ $(omarchy-bar get omarchy.power showPercentage) == true ]]"},
  "appearance.top-bar.indicators.battery-percentage-off": {"when":"false"},
  "appearance.dock.autohide": {"label":"Auto-hide Dock","toggle":true,"when":"true","checked":"[[ $(omarchy-dock autohide) == \"on\" ]]","action":"if [[ $(omarchy-dock autohide) == on ]]; then omarchy-dock autohide off; else omarchy-dock autohide on; fi"},
  "appearance.dock.always-on": {"when":"false"},
